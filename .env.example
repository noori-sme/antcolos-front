# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time:
# never put a secret in one, and rebuild (not just restart) after changing them.

# Which service adapters the app resolves to: "mock" (in-memory, default) or "http" (NestJS API).
NEXT_PUBLIC_API_MODE=mock

# NestJS API base URL, including the global prefix and version.
#   staging:     https://antcolos-staging.up.railway.app/api/v1   (default when unset)
#   local stack: http://localhost:3000/api/v1  (then run this app with `npm run dev -- -p 3001`)
NEXT_PUBLIC_API_URL=https://antcolos-staging.up.railway.app/api/v1

# Public origin of this site, used for absolute share/profile links and metadata.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Playwright only: use a Chromium already on the machine instead of Playwright's download.
# CHROMIUM_PATH=/usr/bin/chromium
